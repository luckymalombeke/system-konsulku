# =========================================================================
# KonsulKu - Frontend Configuration Template (.env.example)
# =========================================================================
#
# Salin file ini menjadi ".env" atau ".env.local" di dalam folder ini,
# kemudian sesuaikan isinya dengan alamat server backend Anda.
#

# 🌐 URL API Backend Go (REST API)
# - Pengujian Lokal: Biarkan kosong untuk menggunakan fallback otomatis (http://localhost:8081)
# - Produksi: Ganti dengan alamat domain API backend Anda yang aktif
VITE_API_URL=https://konsulku-production.up.railway.app

# 💬 URL WebSocket Backend Go (Real-time Chat & Notifikasi)
# - Pengujian Lokal: Biarkan kosong untuk menggunakan fallback otomatis (ws://localhost:8081)
# - Produksi: Ganti dengan alamat WebSocket domain API backend Anda (gunakan protokol wss://)
VITE_WS_URL=wss://konsulku-production.up.railway.app
